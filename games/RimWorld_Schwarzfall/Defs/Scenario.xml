<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ScenarioDef>
    <defName>Schwarzfall_Germany</defName>
    <label>Schwarzfall: Германия, первая ночь</label>
    <description>Посёлок под Кёльном, октябрь. В 22:14 гаснет свет по всей Европе. У вас: четверо соседей, кладовая, аптечка, солярка из бака машины, инструменты и радио на батарейках. Телефоны молчат к утру, вода из крана идёт ещё сутки. Дальше — по хронологии настоящего блэкаута: события приходят по дням, а свет вы делаете себе сами.</description>
    <scenario>
      <summary>Германия наших дней. Общеевропейский блэкаут в первую ночь; события по хронологии реальной катастрофы; развитие — своя энергия.</summary>
      <playerFaction><def>PlayerFaction</def><factionDef>PlayerColony</factionDef></playerFaction>
      <parts>
        <li Class="ScenPart_ConfigPage_ConfigureStartingPawns"><def>ConfigPage_ConfigureStartingPawns</def><pawnCount>4</pawnCount><pawnChoiceCount>8</pawnChoiceCount></li>
        <li Class="ScenPart_PlayerPawnsArriveMethod"><def>PlayerPawnsArriveMethod</def><method>Standing</method></li>
        <li Class="ScenPart_StartingResearch"><def>StartingResearch</def><project>Electricity</project></li>
        <li Class="ScenPart_StartingResearch"><def>StartingResearch</def><project>Batteries</project></li>
        <li Class="ScenPart_StartingResearch"><def>StartingResearch</def><project>ComplexClothing</project></li>
        <li Class="ScenPart_StartingResearch"><def>StartingResearch</def><project>Stonecutting</project></li>
        <li Class="ScenPart_StartingResearch"><def>StartingResearch</def><project>ComplexFurniture</project></li>
        <li Class="ScenPart_StartingThing_Defined"><def>StartingThing_Defined</def><thingDef>MealSurvivalPack</thingDef><count>36</count></li>
        <li Class="ScenPart_StartingThing_Defined"><def>StartingThing_Defined</def><thingDef>Chemfuel</thingDef><count>60</count></li>
        <li Class="ScenPart_StartingThing_Defined"><def>StartingThing_Defined</def><thingDef>MedicineIndustrial</thingDef><count>6</count></li>
        <li Class="ScenPart_StartingThing_Defined"><def>StartingThing_Defined</def><thingDef>ComponentIndustrial</thingDef><count>10</count></li>
        <li Class="ScenPart_StartingThing_Defined"><def>StartingThing_Defined</def><thingDef>Steel</thingDef><count>250</count></li>
        <li Class="ScenPart_StartingThing_Defined"><def>StartingThing_Defined</def><thingDef>WoodLog</thingDef><count>300</count></li>
        <li Class="ScenPart_StartingThing_Defined"><def>StartingThing_Defined</def><thingDef>Cloth</thingDef><count>80</count></li>
        <li Class="ScenPart_StartingThing_Defined"><def>StartingThing_Defined</def><thingDef>Silver</thingDef><count>120</count></li>
        <li Class="ScenPart_StartingThing_Defined"><def>StartingThing_Defined</def><thingDef>Schwarzfall_Radio</thingDef><count>1</count></li>
        <li Class="ScenPart_StartingThing_Defined"><def>StartingThing_Defined</def><thingDef>Schwarzfall_Handbook</thingDef><count>1</count></li>
        <li Class="ScenPart_GameStartDialog"><def>GameStartDialog</def><text>22:14. Лампы мигнули дважды и погасли. Из окна видно: темно не только у вас — темно до горизонта. Радио на батарейках ловит одну станцию: «…нарушение частоты… отключение потребителей по всей континентальной Европе… оставайтесь дома». Утром замолчат телефоны. Через сутки перестанет идти вода.\n\nСвет теперь делают руками. Первое исследование — ИБП из автомобильных аккумуляторов.</text></li>
        <!-- хронология блэкаута: события по дням -->
        <li Class="ScenPart_CreateIncident"><def>CreateIncident</def><incident>SF_Night1</incident><delayDays>0.05</delayDays><repeat>false</repeat></li>
        <li Class="ScenPart_CreateIncident"><def>CreateIncident</def><incident>SF_Day1_Water</incident><delayDays>1.2</delayDays><repeat>false</repeat></li>
        <li Class="ScenPart_CreateIncident"><def>CreateIncident</def><incident>SF_Day3_Fuel</incident><delayDays>3.1</delayDays><repeat>false</repeat></li>
        <li Class="ScenPart_CreateIncident"><def>CreateIncident</def><incident>SF_Day6_Cold</incident><delayDays>6.0</delayDays><repeat>false</repeat></li>
        <li Class="ScenPart_CreateIncident"><def>CreateIncident</def><incident>ColdSnap</incident><delayDays>9.0</delayDays><repeat>false</repeat></li>
        <li Class="ScenPart_CreateIncident"><def>CreateIncident</def><incident>RaidEnemy</incident><delayDays>7.3</delayDays><repeat>false</repeat></li>
        <li Class="ScenPart_CreateIncident"><def>CreateIncident</def><incident>RaidEnemy</incident><delayDays>11.6</delayDays><repeat>false</repeat></li>
        <li Class="ScenPart_CreateIncident"><def>CreateIncident</def><incident>RaidEnemy</incident><delayDays>14.4</delayDays><repeat>false</repeat></li>
        <li Class="ScenPart_CreateIncident"><def>CreateIncident</def><incident>SF_Day14_Islands</incident><delayDays>14.0</delayDays><repeat>false</repeat></li>
        <li Class="ScenPart_CreateIncident"><def>CreateIncident</def><incident>SF_Day20_Cloud</incident><delayDays>20.5</delayDays><repeat>false</repeat></li>
        <li Class="ScenPart_CreateIncident"><def>CreateIncident</def><incident>SF_Day29_Grid</incident><delayDays>29.0</delayDays><repeat>false</repeat></li>
        <li Class="ScenPart_CreateIncident"><def>CreateIncident</def><incident>SF_Day45_Restored</incident><delayDays>45.0</delayDays><repeat>false</repeat></li>
        <li Class="ScenPart_CreateIncident"><def>CreateIncident</def><incident>TraderCaravanArrival</incident><delayDays>16.0</delayDays><repeat>false</repeat></li>
        <!-- космос и психика выключены: это Германия -->
        <li Class="ScenPart_DisableIncident"><def>DisableIncident</def><incident>SolarFlare</incident></li>
        <li Class="ScenPart_DisableIncident"><def>DisableIncident</def><incident>ShipChunkDrop</incident></li>
        <li Class="ScenPart_DisableIncident"><def>DisableIncident</def><incident>PsychicDrone</incident></li>
        <li Class="ScenPart_DisableIncident"><def>DisableIncident</def><incident>PsychicSoothe</incident></li>
        <li Class="ScenPart_DisableIncident"><def>DisableIncident</def><incident>Infestation</incident></li>
        <li Class="ScenPart_DisableIncident"><def>DisableIncident</def><incident>ToxicFallout</incident></li>
        <li Class="ScenPart_DisableIncident"><def>DisableIncident</def><incident>VolcanicWinter</incident></li>
        <li Class="ScenPart_DisableIncident"><def>DisableIncident</def><incident>ManhunterPack</incident></li>
        <li Class="ScenPart_DisableIncident"><def>DisableIncident</def><incident>MeteoriteImpact</incident></li>
        <li Class="ScenPart_DisableIncident"><def>DisableIncident</def><incident>ResourcePodCrash</incident></li>
        <li Class="ScenPart_DisableIncident"><def>DisableIncident</def><incident>RefugeePodCrash</incident></li>
      </parts>
    </scenario>
  </ScenarioDef>
</Defs>
