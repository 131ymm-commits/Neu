<root>
    <styles>
        <include src="file://{resources}/styles/custom_game/coach_hud.css" />
    </styles>
    <scripts>
        <include src="file://{resources}/scripts/custom_game/coach_hud.js" />
    </scripts>
    <!-- ASCII only: Russian texts are set by coach_hud.js (live match 2026-10-11: layout failed to compile) -->
    <Panel id="CoachRoot" hittest="false">
        <Label id="CoachMode" hittest="false" text="..." />
        <Panel id="CoachAgents" hittest="false" />
        <Panel id="CoachLog" hittest="false" />
        <Panel id="CoachBar">
            <Label id="CoachPrompt" class="CoachPrompt" text="..." />
            <TextEntry id="CoachInput" maxchars="200" />
            <Button id="CoachHelpButton" class="CoachButton">
                <Label text="?" />
            </Button>
        </Panel>
        <Panel id="CoachSheet" class="Hidden">
            <Label id="CoachSheetText" class="CoachSheetText" text="..." />
        </Panel>
    </Panel>
</root>
