6833741", "714731847", "540140873", "642937736", "479223920", "892578186", "546180639", "330256032", "908902436", "384009399", "488099409"], "note": "\u0412\u0441\u0435 30 \u0437\u043d\u0430\u0447\u0435\u043d\u0438\u0439 \u043f\u043e\u0441\u0447\u0438\u0442\u0430\u043d\u044b \u0432\u0440\u0443\u0447\u043d\u0443\u044e, \u0431\u0435\u0437 \u0438\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u043e\u0432, \u043a\u0430\u043a \u0442\u0440\u0435\u0431\u043e\u0432\u0430\u043b\u043e \u0437\u0430\u0434\u0430\u043d\u0438\u0435. \u041f\u0440\u043e\u0432\u0435\u0440\u043e\u043a \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u043e\u0439 \u043d\u0435 \u0431\u044b\u043b\u043e. \u041a\u0430\u0436\u0434\u044b\u0439 \u0448\u0430\u0433 \u043f\u0435\u0440\u0435\u0441\u0447\u0438\u0442\u0430\u043d \u043e\u0434\u0438\u043d \u0440\u0430\u0437. \u041c\u0435\u0442\u043e\u0434: \u0447\u0438\u0441\u043b\u043e x \u0440\u0430\u0441\u043a\u043b\u0430\u0434\u044b\u0432\u0430\u0435\u0442\u0441\u044f \u043a\u0430\u043a A*10^5 + B. \u0422\u0430\u043a \u043a\u0430\u043a 10^9 = -7 \u043f\u043e \u043c\u043e\u0434\u0443\u043b\u044e p, \u043f\u043e\u043b\u0443\u0447\u0430\u0435\u0442\u0441\u044f 10^10 = -70, \u0438 x^2 = -70*A^2 + 2AB*10^5 + B^2 (mod p). \u0421\u043b\u0430\u0433\u0430\u0435\u043c\u043e\u0435 2AB*10^5 \u0441\u043e\u043a\u0440\u0430\u0449\u0430\u043b\u043e\u0441\u044c \u0442\u0430\u043a: -7*(2AB div 10^4) + (2AB mod 10^4)*10^5. \u0417\u0430\u0442\u0435\u043c \u043f\u0440\u0438\u0431\u0430\u0432\u043b\u044f\u043b\u043e\u0441\u044c 727 \u0438 \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442 \u043f\u0440\u0438\u0432\u043e\u0434\u0438\u043b\u0441\u044f \u0432 \u0434\u0438\u0430\u043f\u0430\u0437\u043e\u043d [0, p). \u0415\u0441\u043b\u0438 \u0445\u043e\u0442\u044c \u0432 \u043e\u0434\u043d\u043e\u043c \u0448\u0430\u0433\u0435 \u043e\u0448\u0438\u0431\u043a\u0430, \u0432\u0441\u0435 \u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0438\u0435 \u0437\u043d\u0430\u0447\u0435\u043d\u0438\