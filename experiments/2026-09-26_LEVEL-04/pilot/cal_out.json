043f\u044b \u043f\u043e \u0442\u0440\u0438 \u0446\u0438\u0444\u0440\u044b, \u043a\u0432\u0430\u0434\u0440\u0430\u0442 \u0441\u043e\u0431\u0438\u0440\u0430\u0435\u0442\u0441\u044f \u043a\u0430\u043a 18-\u0437\u043d\u0430\u0447\u043d\u043e\u0435 \u0447\u0438\u0441\u043b\u043e N = Q*10^9 + R. \u0422\u0430\u043a \u043a\u0430\u043a 10^9 \u2261 -7 (mod 1000000007), \u043e\u0441\u0442\u0430\u0442\u043e\u043a \u0440\u0430\u0432\u0435\u043d R - 7Q, \u043f\u0440\u0438\u0432\u0435\u0434\u0451\u043d\u043d\u043e\u043c\u0443 \u043a \u043d\u0443\u0436\u043d\u043e\u043c\u0443 \u0434\u0438\u0430\u043f\u0430\u0437\u043e\u043d\u0443 \u043f\u0440\u0438\u0431\u0430\u0432\u043b\u0435\u043d\u0438\u0435\u043c \u043a\u0440\u0430\u0442\u043d\u043e\u0433\u043e p, \u043f\u043e\u0441\u043b\u0435 \u0447\u0435\u0433\u043e \u043f\u0440\u0438\u0431\u0430\u0432\u043b\u044f\u0435\u0442\u0441\u044f 697. \u0412\u0441\u0435 \u043a\u0432\u0430\u0434\u0440\u0430\u0442\u044b \u0442\u0440\u0451\u0445\u0437\u043d\u0430\u0447\u043d\u044b\u0445 \u0447\u0430\u0441\u0442\u0435\u0439 \u043f\u0435\u0440\u0435\u043f\u0440\u043e\u0432\u0435\u0440\u0435\u043d\u044b. \u0428\u0430\u0433\u0438 6 \u0438 26 \u0434\u043e\u043f\u043e\u043b\u043d\u0438\u0442\u0435\u043b\u044c\u043d\u043e \u043f\u0435\u0440\u0435\u0441\u0447\u0438\u0442\u0430\u043d\u044b \u0447\u0435\u0440\u0435\u0437 \u043e\u0442\u0440\u0438\u0446\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u0435 \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u0438\u0435 (x \u2261 x - p) \u0438 \u0441\u043e\u0432\u043f\u0430\u043b\u0438. \u0418\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u0430\u043c\u0438 \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442 \u043d\u0435 \u043f\u0440\u043e\u0432\u0435\u0440\u044f\u043b\u0441\u044f, \u0442\u0430\u043a \u0447\u0442\u043e \u043d\u0435\u0431\u043e\u043b\u044c\u0448\u043e\u0439 \u0440\u0438\u0441\u043a \u0430\u0440\u0438\u0444\u043c\u0435\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u043e\u0448\u0438\u0431\u043a\u0438 \u043e\u0441\u0442\u0430\u0451\u0442\u0441\u044f."}, {"values": ["909396206", "698184962", "750706482", "171895495", "994459302", "411682829", "507064688", "16735869", "309225235", "291464207", "367479865", "235128772", "35229908", "409001139", "532324508", "833857108", "694900664", "447433090", "625574221", "240355817", "361341760", "605923235", "142865174", "799177774", "984800010", "907183433", "348793761", "860926216", "207721745", "43807461"], "note": "\u0412\u0441\u0435 \u0437\u043d\u0430\u0447\u0435\u043d\u0438\u044f \u043f\u043e\u0441\u0447\u0438\u0442\u0430\u043d\u044b \u0432 \u0443\u043c\u0435, \u0431\u0435\u0437 \u0438\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u043e\u0432. \u041c\u0435\u0442\u043e\u0434: x \u0434\u0435\u043b\u0438\u0442\u0441\u044f \u043d\u0430 \u0442\u0440\u0438 \u0433\u0440\u0443\u043f\u043f\u044b \u043f\u043e 3 \u0446\u0438\u0444\u0440\u044b (a, b, c). \u0418\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0435\u0442\u0441\u044f 10^9 \u2261 -7 \u0438 10^12 \u2261 -7000 \u043f\u043e \u043c\u043e\u0434\u0443\u043b\u044e p = 1000000007, \u0442\u0430\u043a \u0447\u0442\u043e x^2 \u2261 c^2 + 2bc*10^3 + (2ac+b^2)*10^6 - 14ab - 7000a^2. \u0417\u0430\u0442\u0435\u043c \u043f\u0440\u0438\u0431\u0430\u0432\u043b\u044f\u0435\u0442\u0441\u044f 697 \u0438 \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442 \u043f\u0440\u0438\u0432\u043e\u0434\u0438\u0442\u0441\u044f \u0432 \u0434\u0438\u0430\u043f\u0430\u0437\u043e\u043d [0, p). \u041a\u0430\u0436\u0434\u043e\u0435 \u0443\u043c\u043d\u043e\u0436\u0435\u043d\u0438\u0435 \u043f\u0440\u043e\u0432\u0435\u0440\u0435\u043d\u043e \u043e\u0434\u0438\u043d \u0440\u0430\u0437. \u041c\u0430\u0448\u0438\u043d\u043d\u043e\u0439 \u043f\u0440\u043e\u0432\u0435\u0440\u043a\u0438 \u043d\u0435 \u0431\u044b\u043b\u043e: \u0435\u0441\u043b\u0438 \u043d\u0430 \u043a\u0430\u043a\u043e\u043c-\u0442\u043e \u0448\u0430\u0433\u0435 \u0435\u0441\u0442\u044c \u043e\u0448\u0438\u0431\u043a\u0430, \u0432\u0441\u0435 \u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0438\u0435 \u0437\u043d\u0430\u0447\u0435\u043d\u0438\u044f \u043d\u0435\u0432\u0435\u0440\u043d\u044b."}]}