#!/bin/bash
# LINUX-02, пилот (PLAN-PILOT.md; уточнения до оценки — DEVIATIONS.md; числа — harness/README.md). Одной цепочкой, чтобы
# отбор модулей сработал по правилу до того, как я увижу промежуточные числа:
#   1) проверка обвязки — оригиналы: KUnit, оригинал против себя (обычные входы и крайние), то же под UBSan;
#   2) оценка переводов обеих версий пилота — pilot (поручения v1, 17 переводов) и pilot2 (поручения test, DEVIATIONS п. 9):
#      rustc, KUnit, сравнение с оригиналом (20 000 проверок на функцию);
#   3) мутанты шести модулей на фазе модуля (errseq — pilot, остальные — pilot2): основы, три прогона каждого мутанта;
#   4) отбор модулей в тест — пять условий, механически (harness/select_modules.py).
# Процессор раннера, без ключей; головы не вызываются.
set -uo pipefail
OUT=$(realpath "$1")
E=experiments/2026-11-19_LINUX-02
command -v rustc >/dev/null || { curl -sSf https://sh.rustup.rs | sh -s -- -y; }
source "$HOME/.cargo/env" 2>/dev/null || true
{ gcc --version | head -1; rustc --version; nproc; git rev-parse HEAD; } | tee "$OUT/versions.txt"
cd $E || exit 1
T0=$(date +%s)
python3 harness/run.py check "$OUT/check.json" | tee "$OUT/check.log" || echo "проверка обвязки: код выхода не 0" | tee -a "$OUT/check.log"
for ph in pilot pilot2; do
  python3 harness/run.py eval "$OUT/eval_$ph.json" $ph | tee "$OUT/eval_$ph.log" || echo "оценка $ph: код выхода не 0" | tee -a "$OUT/eval_$ph.log"
done
mkdir -p "$OUT/mutants"
for m in errseq 842_decompress md5 random32 min_heap string_helpers; do
  ph=pilot2; [ "$m" = errseq ] && ph=pilot
  python3 harness/mutants.py "$OUT/mutants/mutants_$m.json" "$m" --phase $ph --per-file 25 --seed 17 | tee -a "$OUT/mutants.log" \
    || echo "мутанты $m: код выхода не 0" | tee -a "$OUT/mutants.log"
done
python3 harness/select_modules.py "$OUT/check.json" "$OUT/mutants" "$OUT/select.json" --eval pilot="$OUT/eval_pilot.json" \
  --eval pilot2="$OUT/eval_pilot2.json" --phase-of errseq=pilot --default-phase pilot2 | tee "$OUT/select.log"
echo "время: $(( $(date +%s) - T0 )) с" | tee -a "$OUT/select.log"
